# ==============================================================================
# SUPER OSINT AI AGENT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- AI LLM PROVIDERS (Set at least one; the agent supports auto-fallback) ---
# Google Gemini (Generous free tier: https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq (Ultra-fast & free tier: https://console.groq.com/)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (Access to 100+ models, many free: https://openrouter.ai/)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# OpenAI (Optional: https://platform.openai.com/)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude (Optional: https://console.anthropic.com/)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Preferred default provider: "gemini", "groq", "openrouter", "openai", or "anthropic"
DEFAULT_LLM_PROVIDER=gemini

# --- SANDBOX & BROWSER EXECUTION (Choose your preferred free tier) ---
# E2B Sandbox (Free monthly code & browser sandbox: https://e2b.dev/)
E2B_API_KEY=

# Optional Remote Scraping API (e.g. ScrapingDog, ScrapingAnt, or Firecrawl)
SCRAPING_API_KEY=
SCRAPING_API_PROVIDER=direct

# --- CLOUD STORAGE & INTEL DATABASE (SUPABASE) ---
# Supabase (Free 1GB S3 Storage + Postgres: https://supabase.com/)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=osint-reports

# --- SERVER CONFIGURATION ---
HOST=0.0.0.0
PORT=8000
DEBUG=true
AUTH_SECRET=super-osint-secret-key-change-me
